def resource_path(filename):
    """Return a file path that works both normally and inside a PyInstaller EXE."""
    if getattr(sys, "frozen", False) and hasattr(sys, "_MEIPASS"):
        return Path(sys._MEIPASS) / filename
    return Path(__file__).resolve().parent / filename


GOOD_TILE_SOUND = resource_path("tilescanner.wav")


STOP_EVENT = threading.Event()
OVERLAY_LOCK = threading.Lock()
OVERLAY_DATA = {
    "status": "Waiting for map...",
    "rooms": [],
    "total": 0,
    "good": False,
    "color": "#f0c674",
}


def set_overlay(status, rooms=None, total=0, good=False, color="#f0c674"):
    with OVERLAY_LOCK:
        OVERLAY_DATA["status"] = status
        OVERLAY_DATA["rooms"] = rooms or []
        OVERLAY_DATA["total"] = total
        OVERLAY_DATA["good"] = good
        OVERLAY_DATA["color"] = color


class TileOverlay:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("tilescaner")
        self.root.overrideredirect(True)
        self.root.attributes("-topmost", True)
        self.root.attributes("-alpha", 0.94)
        self.root.configure(bg="black")

        width = 500
        height = 92
        x = (self.root.winfo_screenwidth() - width) // 2
        self.root.geometry(f"{width}x{height}+{x}+12")

        self.status_label = tk.Label(
            self.root,
            text="Waiting for map...",
            bg="black",
            fg="#f0c674",
            font=("Segoe UI", 14, "bold"),
        )
        self.status_label.pack(pady=(8, 1))

        self.rooms_label = tk.Label(
            self.root,
            text="",
            bg="black",
            fg="white",
            font=("Segoe UI", 10),
        )
        self.rooms_label.pack()

        self.hint_label = tk.Label(
            self.root,
            text="drag to move • right-click or Esc to close",
            bg="black",
            fg="#777777",
            font=("Segoe UI", 8),
        )
        self.hint_label.pack(pady=(2, 0))

        self.drag_x = 0
        self.drag_y = 0
        self.root.bind("<Button-1>", self.start_drag)
        self.root.bind("<B1-Motion>", self.drag)
        self.root.bind("<Button-3>", self.close)
        self.root.bind("<Escape>", self.close)

        self.refresh()

    def start_drag(self, event):
        self.drag_x = event.x
        self.drag_y = event.y

    def drag(self, event):
        x = self.root.winfo_x() + event.x - self.drag_x
        y = self.root.winfo_y() + event.y - self.drag_y
        self.root.geometry(f"+{x}+{y}")

    def close(self, event=None):
        STOP_EVENT.set()
        self.root.destroy()

    def refresh(self):
        if STOP_EVENT.is_set():
            try:
                self.root.destroy()
            except tk.TclError:
                pass
            return

        with OVERLAY_LOCK:
            data = dict(OVERLAY_DATA)

        self.status_label.config(
            text=data["status"],
            fg=data["color"],
        )

        if data["rooms"]:
            room_text = "   |   ".join(
                f"{name} ({exos})" for name, exos in data["rooms"]
            )
        else:
            room_text = ""

        self.rooms_label.config(text=room_text)
        self.root.after(150, self.refresh)

    def run(self):
        self.root.mainloop()


def run_overlay():
    if tk is None:
        print("Overlay unavailable: tkinter is not installed.")
        return

    try:
        TileOverlay().run()
    except Exception as error:
        print(f"Overlay error: {error}")


