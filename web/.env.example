# Copy to .env and fill in. Never commit .env.
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=
# Your warframe.market username. Display only, no key needed for this.
WFM_USERNAME=
# Your JWT comes from signing in through the UI. You can also paste one
# by hand from a logged-in browser session. It expires, sign in again
# when the UI says the login went stale.
WFM_JWT=
