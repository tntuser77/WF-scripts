# Copy to .env and fill in. Never commit .env.
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=
# Your warframe.market username. Display only, no key needed for this.
WFM_USERNAME=
# Your JWT cookie from a logged-in browser session. Lets Best to list
# hide your active orders whatever your online status. Expires, paste
# a fresh one when the UI says the login went stale.
WFM_JWT=
